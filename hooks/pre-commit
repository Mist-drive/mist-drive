#!/bin/sh
# Format + vet + tests (unit, no race) before every commit — the full
# race-detector check + integration tests run in CI, not here (race
# tests are slow, not worth the wait on every commit). Install with
# `make install-hooks`.
make fmt
git add -u

echo "Running go vet + tests..."
if ! (cd api && go vet ./... && go test ./... -count=1); then
    echo ""
    echo "✗ Checks failed. Fix issues above before committing."
    exit 1
fi

exit 0
